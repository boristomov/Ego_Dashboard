{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheHeartbeatPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::egodata-raw-prod-854929212137-us-west-2-an",
      "Condition": {
        "StringLike": {
          "s3:prefix": "_fleet/*"
        }
      }
    },
    {
      "Sid": "ReadTheHeartbeats",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::egodata-raw-prod-854929212137-us-west-2-an/_fleet/*"
    }
  ]
}
